# ---------------------------------------------------------------------------
# Website (Next.js). Copy to frontend/.env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Port the site listens on in production (loopback only; nginx proxies to it).
# This server hosts ~11 other sites. Port 3000 is already taken there by another
# next-server, so 3015 is the chosen port. It must match the `upstream` block in
# deploy/nginx-new-staging.conf (staging) and deploy/nginx-telkganesan.conf (cutover).
APP_PORT=3015

# Where the Next.js server reaches the backend API (backend/.env API_PORT).
BACKEND_URL=http://127.0.0.1:4000
# Same value as backend/.env INTERNAL_API_KEY. Server-side only, never exposed to browsers.
INTERNAL_API_KEY=

# Application origin. Used for canonicals and metadata.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional GA4 measurement ID. Analytics stays inert unless this is set AND the
# visitor grants consent. Leave blank in development.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Production launch switches. Leave both unset in development and staging: robots.txt then
# stays `Disallow: /` and sitemap.xml stays empty. Set both ONLY on the verified live
# deployment (they can also be set in the database under Site Settings).
#   PRODUCTION_ORIGIN=https://telkganesan.com
#   ALLOW_INDEXING=true
PRODUCTION_ORIGIN=
ALLOW_INDEXING=
