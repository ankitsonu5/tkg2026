# ---------------------------------------------------------------------------
# Tel K. Ganesan platform — local development environment.
# Copy to .env and fill in. NEVER commit .env. No production value belongs here.
# ---------------------------------------------------------------------------

# Application origin. Used for canonicals, CSRF and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# MongoDB. Local development database; a local `mongod` creates the database
# automatically on first write, nothing to pre-create.
DATABASE_URI=mongodb://127.0.0.1:27017/tel_ganesan_dev

# Payload signing secret. Generate a fresh one, do not reuse across environments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Local email capture (npm run mail:dev listens on 1025 and writes .mail/*.eml).
# Production requires a real provider with TLS and credentials — not configured here.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME=Tel K. Ganesan Platform (development)

# Shared secret for GET /api/cron/deliver (retries queued emails on hosting with no
# long-running worker). Endpoint is disabled while this is empty.
CRON_SECRET=

# Optional GA4 measurement ID. Analytics stays inert unless this is set AND the
# visitor grants consent. Leave blank in development.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Production launch switches. Leave both unset in development and staging: robots.txt then
# stays `Disallow: /` and sitemap.xml stays empty. Set both ONLY on the verified live
# deployment (they can also be set in the CMS under Site Settings).
#   PRODUCTION_ORIGIN=https://telkganesan.com
#   ALLOW_INDEXING=true
PRODUCTION_ORIGIN=
ALLOW_INDEXING=

# Guard rail: development seeds refuse to run unless this is exactly "development".
NODE_ENV=development
