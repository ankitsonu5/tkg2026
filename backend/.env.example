# ---------------------------------------------------------------------------
# Backend API (Express + MongoDB). Copy to backend/.env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Where the API listens. Loopback only: the Next.js site (and nginx in front of it) is the
# only public entry point. frontend/.env BACKEND_URL must point here.
API_PORT=4000
API_HOST=127.0.0.1

# MongoDB. The same database the site has always used; collections keep their names.
# A local `mongod` creates the database automatically on first write.
DATABASE_URI=mongodb://127.0.0.1:27017/tel_ganesan_dev

# Shared secret between the Next.js server and this API (same value in frontend/.env).
# Required in production. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Salt for the hashed rate-limit buckets. Required in production. If you are migrating an
# existing deployment, reuse the old PAYLOAD_SECRET value so existing buckets still match.
APP_SECRET=

# Public site origin, used for absolute links in emails (newsletter confirmation).
PUBLIC_SITE_URL=http://localhost:3000

# Local email capture (npm run mail:dev listens on 1025 and writes .mail/*.eml).
# Production requires a real provider with TLS and credentials — not configured here.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME=Tel K. Ganesan Platform (development)

# Shared secret for GET /api/cron/deliver (retries queued emails on hosting with no
# long-running worker). Endpoint is disabled while this is empty.
CRON_SECRET=

# Media files: local folder (relative to backend/) and, in production, a Vercel Blob store.
MEDIA_DIR=media
BLOB_READ_WRITE_TOKEN=

# Guard rail: development seeds refuse to run unless this is exactly "development".
NODE_ENV=development
