{
  "name": "tel-ganesan-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Tel K. Ganesan platform API: Node.js + Express + MongoDB (Mongoose).",
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker:delivery": "tsx scripts/run-jobs.ts",
    "mail:dev": "tsx scripts/dev-mail-server.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:production": "tsx scripts/seed-production.ts",
    "import:redirects": "tsx scripts/import-redirects.ts",
    "set:inquiry-recipient": "tsx scripts/set-inquiry-recipient.ts",
    "smoke:inquiry": "tsx scripts/smoke-inquiry.ts",
    "set:admin-password": "tsx scripts/set-admin-password.ts",
    "import:site-content": "tsx scripts/import-site-content.ts",
    "import:site-media": "tsx scripts/import-site-media.ts"
  },
  "dependencies": {
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "mongoose": "8.24.1",
    "multer": "2.4.0",
    "nodemailer": "9.1.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.19.9",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
